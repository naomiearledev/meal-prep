# Shared password for the single login. Required.
APP_PASSWORD=change-me

# Secret used to sign the login cookie. Any long random string. Required.
AUTH_SECRET=change-me-to-something-long-and-random

# Optional. Where the SQLite database file lives. Defaults to data/app.db.
# DATABASE_PATH=data/app.db

# Optional. Where recipe photos are stored. Defaults to data/uploads.
# UPLOADS_DIR=data/uploads
